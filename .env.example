# ==============================================================================
# Environment Configuration Template — APAAR Student Platform
# Copy this file to .env and adjust variables as required.
# NEVER commit .env to source control!
# ==============================================================================

# Backend API configuration (Member 2)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (PostgreSQL / MySQL / SQLite)
DATABASE_URL=sqlite:///./apaar_dev.db

# Frontend Configuration (Member 1)
VITE_API_URL=/api/v1
PORT=3000

# Mock Adapters & Integrations (Member 3)
ENABLE_MOCK_APAAR_VALIDATION=true
ENABLE_MOCK_DIGILOCKER_INTEGRATION=true

